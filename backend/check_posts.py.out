    "updated_at": "2026-05-12 10:06:37.861380+00:00",
    "caption": "Guptkashi \u0909\u0924\u094d\u0924\u0930\u093e\u0916\u0902\u0921 \u0915\u0940 \u0939\u093f\u092e\u093e\u0932\u092f\u0940 \u0935\u093e\u0926\u093f\u092f\u094b\u0902 \u092e\u0947\u0902 \u0938\u094d\u0925\u093f\u0924 \u092d\u0917\u0935\u093e\u0928 Lord Shiva \u0915\u0940 \u0905\u0924\u094d\u092f\u0902\u0924 \u092a\u0935\u093f\u0924\u094d\u0930 \u0914\u0930 \u0926\u093f\u0935\u094d\u092f \u0928\u0917\u0930\u0940 \u092e\u093e\u0928\u0940 \u091c\u093e\u0924\u0940 \u0939\u0948\u0964 \u092f\u0939 \u0938\u094d\u0925\u093e\u0928 \u0938\u0928\u093e\u0924\u0928 \u0927\u0930\u094d\u092e \u092e\u0947\u0902 \u0935\u093f\u0936\u0947\u0937 \u092e\u0939\u0924\u094d\u0935 \u0930\u0916\u0924\u093e \u0939\u0948 \u0914\u0930 \u092a\u094d\u0930\u0938\u093f\u0926\u094d\u0927 Kedarnath Temple \u0927\u093e\u092e \u0915\u0947 \u092a\u094d\u0930\u0935\u0947\u0936 \u0926\u094d\u0935\u093e\u0930 \u0915\u0947 \u0930\u0942\u092a \u092e\u0947\u0902 \u091c\u093e\u0928\u093e \u091c\u093e\u0924\u093e \u0939\u0948\u0964\n\u092a\u094c\u0930\u093e\u0923\u093f\u0915 \u092e\u093e\u0928\u094d\u092f\u0924\u093e\u0913\u0902 \u0915\u0947 \u0905\u0928\u0941\u0938\u093e\u0930 \u092e\u0939\u093e\u092d\u093e\u0930\u0924 \u092f\u0941\u0926\u094d\u0927 \u0915\u0947 \u092c\u093e\u0926 \u092a\u093e\u0902\u0921\u0935 \u092d\u0917\u0935\u093e\u0928 \u0936\u093f\u0935 \u0915\u0947 \u0926\u0930\u094d\u0936\u0928 \u0915\u0930\u0928\u093e \u091a\u093e\u0939\u0924\u0947 \u0925\u0947, \u0932\u0947\u0915\u093f\u0928 \u092d\u0917\u0935\u093e\u0928 \u0936\u093f\u0935 \u0909\u0928\u0938\u0947 \u092e\u093f\u0932\u0928\u0947 \u0938\u0947 \u092a\u0939\u0932\u0947 \u0917\u0941\u092a\u094d\u0924 \u0930\u0942\u092a \u0938\u0947 \u0907\u0938\u0940 \u0938\u094d\u0925\u093e\u0928 \u092a\u0930 \u0906\u0915\u0930 \u091b\u093f\u092a \u0917\u090f \u0925\u0947\u0964 \u0907\u0938\u0940 \u0915\u093e\u0930\u0923 \u0907\u0938 \u0938\u094d\u0925\u093e\u0928 \u0915\u093e \u0928\u093e\u092e \u201c\u0917\u0941\u092a\u094d\u0924\u0915\u093e\u0936\u0940\u201d \u092a\u0921\u093c\u093e\u0964 \u092f\u0939 \u092d\u0942\u092e\u093f \u0936\u093f\u0935 \u092d\u0915\u094d\u0924\u093f, \u0924\u092a\u0938\u094d\u092f\u093e, \u0927\u094d\u092f\u093e\u0928, \u0935\u0948\u0926\u093f\u0915 \u0938\u0902\u0938\u094d\u0915\u0943\u0924\u093f \u0914\u0930 \u0938\u0928\u093e\u0924\u0928\u0940 \u092a\u0930\u0902\u092a\u0930\u093e\u0913\u0902 \u0915\u093e \u091c\u0940\u0935\u0902\u0924 \u092a\u094d\u0930\u0924\u0940\u0915 \u092e\u093e\u0928\u0940 \u091c\u093e\u0924\u0940 \u0939\u0948\u0964\n\u0917\u0941\u092a\u094d\u0924\u0915\u093e\u0936\u0940 \u092e\u0947\u0902 \u0938\u094d\u0925\u093f\u0924 \u092a\u094d\u0930\u0938\u093f\u0926\u094d\u0927 Vishwanath Temple \u0924\u0925\u093e \u0905\u0930\u094d\u0927\u0928\u093e\u0930\u0940\u0936\u094d\u0935\u0930 \u092e\u0902\u0926\u093f\u0930 \u092d\u0915\u094d\u0924\u094b\u0902 \u0915\u0940 \u0917\u0939\u0930\u0940 \u0906\u0938\u094d\u0925\u093e \u0915\u093e \u0915\u0947\u0902\u0926\u094d\u0930 \u0939\u0948\u0902\u0964 \u092f\u0939\u093e\u0901 \u0915\u093e \u0935\u093e\u0924\u093e\u0935\u0930\u0923 \u092e\u0902\u0926\u093f\u0930\u094b\u0902 \u0915\u0940 \u0918\u0902\u091f\u093f\u092f\u094b\u0902, \u0935\u0948\u0926\u093f\u0915 \u092e\u0902\u0924\u094d\u0930\u094b\u0902, \u0939\u093f\u092e\u093e\u0932\u092f \u0915\u0940 \u0936\u0940\u0924\u0932 \u0939\u0935\u093e\u0913\u0902 \u0914\u0930 \u092d\u0915\u094d\u0924\u093f \u0930\u0938 \u0938\u0947 \u0938\u0926\u0948\u0935 \u0926\u093f\u0935\u094d\u092f \u092c\u0928\u093e \u0930\u0939\u0924\u093e \u0939\u0948\u0964\n\u091a\u093e\u0930\u094b\u0902 \u0913\u0930 \u090a\u0901\u091a\u0947 \u0939\u093f\u092e\u093e\u0932\u092f, \u092a\u0935\u093f\u0924\u094d\u0930 \u0928\u0926\u093f\u092f\u093e\u0901, \u0939\u0930\u093f\u092f\u093e\u0932\u0940 \u0914\u0930 \u0906\u0927\u094d\u092f\u093e\u0924\u094d\u092e\u093f\u0915 \u090a\u0930\u094d\u091c\u093e \u0907\u0938 \u0938\u094d\u0925\u093e\u0928 \u0915\u094b \u090f\u0915 \u0905\u0926\u094d\u092d\u0941\u0924 \u0924\u0940\u0930\u094d\u0925 \u092c\u0928\u093e\u0924\u0947 \u0939\u0948\u0902\u0964 \u0939\u0930 \u0935\u0930\u094d\u0937 \u0939\u091c\u093e\u0930\u094b\u0902 \u0936\u094d\u0930\u0926\u094d\u0927\u093e\u0932\u0941 \u0915\u0947\u0926\u093e\u0930\u0928\u093e\u0925 \u092f\u093e\u0924\u094d\u0930\u093e \u0915\u0947 \u0926\u094c\u0930\u093e\u0928 \u0917\u0941\u092a\u094d\u0924\u0915\u093e\u0936\u0940 \u092e\u0947\u0902 \u0930\u0941\u0915\u0915\u0930 \u092d\u0917\u0935\u093e\u0928 \u0936\u093f\u0935 \u0915\u093e \u0906\u0936\u0940\u0930\u094d\u0935\u093e\u0926 \u092a\u094d\u0930\u093e\u092a\u094d\u0924 \u0915\u0930\u0924\u0947 \u0939\u0948\u0902\u0964\n\u0917\u0941\u092a\u094d\u0924\u0915\u093e\u0936\u0940 \u0915\u0947\u0935\u0932 \u090f\u0915 \u0927\u093e\u0930\u094d\u092e\u093f\u0915 \u0938\u094d\u0925\u0932 \u0928\u0939\u0940\u0902, \u092c\u0932\u094d\u0915\u093f \u0938\u0928\u093e\u0924\u0928 \u0927\u0930\u094d\u092e, \u0939\u093f\u0902\u0926\u0941\u0924\u094d\u0935 \u0938\u0902\u0938\u094d\u0915\u0943\u0924\u093f, \u0936\u093f\u0935 \u092d\u0915\u094d\u0924\u093f, \u092d\u093e\u0930\u0924\u0940\u092f \u0905\u0927\u094d\u092f\u093e\u0924\u094d\u092e \u0914\u0930 \u0939\u093f\u092e\u093e\u0932\u092f\u0940 \u092a\u0930\u0902\u092a\u0930\u093e\u0913\u0902 \u0915\u093e \u0926\u093f\u0935\u094d\u092f \u0938\u0902\u0917\u092e \u0939\u0948\u0964 \u092f\u0939 \u092a\u093e\u0935\u0928 \u0927\u093e\u092e \u0939\u0930 \u092d\u0915\u094d\u0924 \u0915\u0947 \u092e\u0928 \u092e\u0947\u0902 \u0936\u093e\u0902\u0924\u093f, \u0936\u094d\u0930\u0926\u094d\u0927\u093e \u0914\u0930 \u0906\u0927\u094d\u092f\u093e\u0924\u094d\u092e\u093f\u0915 \u090a\u0930\u094d\u091c\u093e \u0915\u093e \u0938\u0902\u091a\u093e\u0930 \u0915\u0930\u0924\u093e \u0939\u0948\u0964\n\n\u0917\u0941\u092a\u094d\u0924\u0915\u093e\u0936\u0940, \u0917\u0941\u092a\u094d\u0924\u0915\u093e\u0936\u0940 \u0909\u0924\u094d\u0924\u0930\u093e\u0916\u0902\u0921, \u0915\u0947\u0926\u093e\u0930\u0928\u093e\u0925 \u092f\u093e\u0924\u094d\u0930\u093e, \u092d\u0917\u0935\u093e\u0928 \u0936\u093f\u0935, \u092e\u0939\u093e\u0926\u0947\u0935, \u0938\u0928\u093e\u0924\u0928 \u0927\u0930\u094d\u092e, \u0939\u093f\u0902\u0926\u0941\u0924\u094d\u0935, \u0936\u093f\u0935 \u092e\u0902\u0926\u093f\u0930, \u0917\u0941\u092a\u094d\u0924\u0915\u093e\u0936\u0940 \u092e\u0902\u0926\u093f\u0930, \u0935\u093f\u0936\u094d\u0935\u0928\u093e\u0925 \u092e\u0902\u0926\u093f\u0930 \u0917\u0941\u092a\u094d\u0924\u0915\u093e\u0936\u0940, \u0909\u0924\u094d\u0924\u0930\u093e\u0916\u0902\u0921 \u092a\u0930\u094d\u092f\u091f\u0928, \u0936\u093f\u0935 \u092d\u0915\u094d\u0924\u093f, \u0939\u093f\u092e\u093e\u0932\u092f, \u0927\u093e\u0930\u094d\u092e\u093f\u0915 \u0938\u094d\u0925\u0932, \u0939\u093f\u0902\u0926\u0942 \u0927\u0930\u094d\u092e, \u0915\u0947\u0926\u093e\u0930\u0928\u093e\u0925 \u0927\u093e\u092e, \u0906\u0927\u094d\u092f\u093e\u0924\u094d\u092e\u093f\u0915 \u092d\u093e\u0930\u0924, \u092e\u0939\u093e\u0926\u0947\u0935 \u0927\u093e\u092e, \u0938\u0928\u093e\u0924\u0928\u0940 \u0938\u0902\u0938\u094d\u0915\u0943\u0924\u093f\n\n#\u0917\u0941\u092a\u094d\u0924\u0915\u093e\u0936\u0940 #\u0915\u0947\u0926\u093e\u0930\u0928\u093e\u0925 #\u092e\u0939\u093e\u0926\u0947\u0935 #\u092d\u0917\u0935\u093e\u0928\u0936\u093f\u0935 #\u0938\u0928\u093e\u0924\u0928\u0927\u0930\u094d\u092e #\u0939\u093f\u0902\u0926\u0941\u0924\u094d\u0935 #\u0936\u093f\u0935\u092d\u0915\u094d\u0924\u093f #\u0909\u0924\u094d\u0924\u0930\u093e\u0916\u0902\u0921 #\u0939\u0930\u0939\u0930\u092e\u0939\u093e\u0926\u0947\u0935 #\u0939\u093f\u0902\u0926\u0942\u0927\u0930\u094d\u092e #\u0915\u0947\u0926\u093e\u0930\u0928\u093e\u0925\u092f\u093e\u0924\u094d\u0930\u093e #\u0926\u0947\u0935\u092d\u0942\u092e\u093f #\u092d\u093e\u0930\u0924\u0940\u092f\u0938\u0902\u0938\u094d\u0915\u0943\u0924\u093f #\u0906\u0927\u094d\u092f\u093e\u0924\u094d\u092e #\u0936\u093f\u0935\u092e\u0902\u0926\u093f\u0930 #\u0938\u0928\u093e\u0924\u0928\u0940 #\u092d\u0915\u094d\u0924\u093f #\u092e\u0939\u093e\u0915\u093e\u0932 #\u0939\u093f\u092e\u093e\u0932\u092f #\u0927\u093e\u0930\u094d\u092e\u093f\u0915\u0938\u094d\u0925\u0932\n\nGuptkashi \u092d\u0917\u0935\u093e\u0928 Lord Shiva \u0915\u0940 \u092a\u0935\u093f\u0924\u094d\u0930 \u0928\u0917\u0930\u0940 \u0914\u0930 Kedarnath Temple \u0915\u093e \u0926\u093f\u0935\u094d\u092f \u092a\u094d\u0930\u0935\u0947\u0936 \u0926\u094d\u0935\u093e\u0930 \u0939\u0948\u0964 \u092f\u0939\u093e\u0901 \u0936\u093f\u0935 \u092d\u0915\u094d\u0924\u093f, \u0938\u0928\u093e\u0924\u0928 \u0927\u0930\u094d\u092e, \u0939\u093f\u092e\u093e\u0932\u092f\u0940 \u0905\u0927\u094d\u092f\u093e\u0924\u094d\u092e \u0914\u0930 \u0939\u093f\u0902\u0926\u0941\u0924\u094d\u0935 \u0938\u0902\u0938\u094d\u0915\u0943\u0924\u093f \u0915\u093e \u0905\u0926\u094d\u092d\u0941\u0924 \u0938\u0902\u0917\u092e \u0926\u0947\u0916\u0928\u0947 \u0915\u094b \u092e\u093f\u0932\u0924\u093e \u0939\u0948\u0964",
