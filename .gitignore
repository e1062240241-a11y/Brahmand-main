# Prevent corrupted mojibake duplicate Ramcharitmanas data files from being re-added.
# Canonical Hindi-named JSON files are tracked and used by the backend routes.
/backend/data/bhavykhatri DharmicData bhavykhatri-AddTransForGita Ramcharitmanas/*╬*
/backend/data/bhavykhatri DharmicData bhavykhatri-AddTransForGita Ramcharitmanas/*Γ*
