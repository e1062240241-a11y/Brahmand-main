{
  "expo": {
    "name": "Brahmand",
    "slug": "sanatan-lok",
    "version": "1.2.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "sanatanlok",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.brahmand.app",
      "googleServicesFile": "./GoogleService-Info.plist",
      "config": {
        "googleMapsApiKey": "AIzaSyBK-mmtVFjREbCAP8Ea_a5RfsL4uCAoSUs"
      },
      "entitlements": {
        "aps-environment": "production",
        "com.apple.developer.associated-domains": [
          "applinks:brahmand.app",
          "applinks:www.brahmand.app"
        ]
      },
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Upload profile photo to your account",
        "NSCameraUsageDescription": "Take photos for profile and messages",
        "NSLocationWhenInUseUsageDescription": "Detect your location to join local communities",
        "NSLocationAlwaysUsageDescription": "Detect your location to join local communities",
        "NSMicrophoneUsageDescription": "Allow Brahmand to use your microphone for voice ordering and live mantra jaap audio rooms.",
        "CFBundleURLTypes": [
          {
            "CFBundleTypeRole": "Editor",
            "CFBundleURLSchemes": [
              "sanatanlok"
            ]
          }
        ],
        "NSSpeechRecognitionUsageDescription": "Allow $(PRODUCT_NAME) to use speech recognition.",
        "UIBackgroundModes": [
          "fetch",
          "remote-notification",
          "audio"
        ],
        "LSApplicationQueriesSchemes": [
          "whatsapp"
        ],
        "ITSAppUsesNonExemptEncryption": false
      },
      "associatedDomains": [
        "applinks:brahmand.app",
        "applinks:www.brahmand.app"
      ]
    },
    "android": {
      "package": "com.brahmand.app",
      "softwareKeyboardLayoutMode": "resize",
      "googleServicesFile": "./google-services.json",
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyBK-mmtVFjREbCAP8Ea_a5RfsL4uCAoSUs"
        }
      },
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#FF6B00"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.FOREGROUND_SERVICE_MICROPHONE"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "sanatanlok"
            }
          ],
          "category": [
            "DEFAULT",
            "BROWSABLE"
          ]
        },
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "brahmand.app"
            },
            {
              "scheme": "http",
              "host": "brahmand.app"
            },
            {
              "scheme": "https",
              "host": "www.brahmand.app"
            },
            {
              "scheme": "http",
              "host": "www.brahmand.app"
            }
          ],
          "category": [
            "DEFAULT",
            "BROWSABLE"
          ]
        }
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 120,
          "resizeMode": "contain",
          "backgroundColor": "#FFF8F0"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Brahmand to access your photos for profile and sharing."
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "16.0",
            "useFrameworks": "static",
            "buildReactNativeFromSource": true
          },
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "ndkVersion": "28.0.12916984"
          }
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow Brahmand to use your location to join local communities."
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Allow Brahmand to use your microphone for voice ordering and live mantra jaap audio rooms."
        }
      ],
      "@react-native-firebase/app",
      "@react-native-firebase/auth",
      "expo-font",
      "expo-image",
      [
        "expo-video",
        {
          "supportsBackgroundPlayback": false,
          "supportsPictureInPicture": true
        }
      ],
      "expo-web-browser",
      [
        "expo-audio",
        {
          "enableBackgroundPlayback": true
        }
      ],
      "expo-sharing",
      [
        "react-native-maps",
        {
          "androidGoogleMapsApiKey": "AIzaSyBK-mmtVFjREbCAP8Ea_a5RfsL4uCAoSUs",
          "iosGoogleMapsApiKey": "AIzaSyBK-mmtVFjREbCAP8Ea_a5RfsL4uCAoSUs"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#FF6B00",
          "defaultChannel": "default_v4",
          "sounds": [
            "./assets/notifysound/bell.mp3",
            "./assets/notifysound/soundreality_mayday_166011.mp3",
            "./assets/notifysound/bell_ios.caf",
            "./assets/notifysound/soundreality_mayday_166011_ios.caf"
          ]
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-secure-store",
      "expo-tracking-transparency"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "4a6b7ff9-0931-43e9-9264-42f7dd7e63a5"
      }
    },
    "owner": "virralpatel"
  }
}