      },
      "env": {
        "EXPO_PUBLIC_BACKEND_URL": "https://brahmand-backend-hi4rz6fdrq-uc.a.run.app"
      },
      "channel": "production"
    }
  },
  "submit": {
    "production": {}
  }
}
