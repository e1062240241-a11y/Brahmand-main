# Example environment variables for the Brahmand frontend.
# Copy this file to `.env` (local dev) or provide the same values as EAS
# secrets (`eas secret:set`) for cloud builds. Never commit real secrets.

# Third-party API keys (critical — fail fast if missing)
EXPO_PUBLIC_GOOGLE_PLACES_API_KEY=
EXPO_PUBLIC_AGORA_APP_ID=

# Backend endpoints
EXPO_PUBLIC_BACKEND_URL=
EXPO_PUBLIC_BACKEND_URL_WEB=

# Firebase web config
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=
EXPO_PUBLIC_FIREBASE_API_KEY_ANDROID=
EXPO_PUBLIC_FIREBASE_API_KEY_IOS=

# Feature flags
EXPO_PUBLIC_ANONYMOUS_PREDEFINED_NUMBERS=
